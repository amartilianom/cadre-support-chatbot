# ==========================================================================
# Cadre Support Chatbot — environment template
# Copy to .env.local and fill in. .env.local is git-ignored; NEVER commit real keys.
# These vars ARE the runtime half of the ClientProfile configuration surface (D-10).
# ==========================================================================

# ---- Chatbot model (OpenRouter) — server-side only, never exposed to the client ----
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug on OpenRouter. Swappable without code change (D-04 / FR-031).
OPENROUTER_MODEL=google/gemini-2.5-flash
# OpenRouter attribution headers (optional but recommended)
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Cadre Support Chatbot

# ---- Database (Supabase) — for lead capture (F3) ----
# From Supabase project → Settings → API. Use the publishable key (sb_publishable_...).
# Server-side only; RLS restricts it to INSERT-only on the leads table (see supabase/schema.sql).
SUPABASE_URL=
SUPABASE_KEY=
